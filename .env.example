# SkyRadar — environment variables
#
# Copy this file to .env.local and fill in values as needed. Nothing here
# is required to run SkyRadar locally: with no FR24 credentials set, the
# app falls back to a built-in live traffic simulator so the full
# experience (radar, silhouettes, Look Here, Sky View, etc.) works out of
# the box.

# Flightradar24 API credentials (server-side only — see src/lib/aircraft/providers).
# When set, SkyRadar's /api/aircraft route calls the real Flightradar24 API
# instead of the local simulator. Never expose these to the client.
FR24_API_KEY=
FR24_API_BASE_URL=https://fr24api.flightradar24.com
