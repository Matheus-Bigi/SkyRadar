# SkyRadar — environment variables
#
# Copy this file to .env.local and fill in values as needed. Nothing here
# is required to run SkyRadar: with no FR24 credentials set, the app uses
# the free OpenSky Network API by default — real ADS-B data, no key
# required. SkyRadar never shows fabricated aircraft in normal operation;
# see AIRCRAFT_PROVIDER below if you specifically want the local simulator
# for development.

# Flightradar24 API credentials (server-side only — see src/lib/aircraft/providers).
# Optional. When set, SkyRadar's /api/aircraft route calls the real
# Flightradar24 API instead of OpenSky. Never expose these to the client.
FR24_API_KEY=
FR24_API_BASE_URL=https://fr24api.flightradar24.com

# OpenSky Network credentials (optional, server-side only). SkyRadar's
# default provider (when FR24_API_KEY isn't set) is OpenSky's free REST API
# — it works anonymously with no signup, but anonymous access is tightly
# rate-limited. Registering a free OpenSky account and setting these raises
# that limit. See https://opensky-network.org for registration.
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
OPENSKY_API_BASE_URL=https://opensky-network.org/api

# Local development ONLY — never set this in a real deployment. Forces
# SkyRadar's built-in fake-traffic simulator instead of real data, so you
# can develop/test without any network calls. The UI shows a permanent
# "SIMULATED DATA" watermark whenever this is active.
AIRCRAFT_PROVIDER=
